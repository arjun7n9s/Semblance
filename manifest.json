{
  "manifest_version": 3,
  "name": "Semblance",
  "version": "1.0.0",
  "description": "Pause at Allow. Read the scopes in plain language. Verify a friend. Revoke in one tap.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Semblance",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "include_globs": ["*demo/allow.html", "*demo/lure.html"],
      "js": [
        "shared/scopes.js",
        "shared/rituals.js",
        "shared/storage.js",
        "shared/ladder.js",
        "content/demo-coach.js"
      ],
      "css": ["content/demo-coach.css"],
      "run_at": "document_idle"
    }
  ]
}
